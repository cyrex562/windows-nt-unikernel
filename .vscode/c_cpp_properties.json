{
    "configurations": [
        {
            "name": "WSL - MinGW Cross-Compile",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/x86_64-w64-mingw32/include/**",
                "/usr/share/mingw-w64/include/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "_WIN64",
                "WIN32",
                "_WIN32",
                "WINVER=0x0A00",
                "_WIN32_WINNT=0x0A00"
            ],
            "compilerPath": "/usr/bin/x86_64-w64-mingw32-gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64",
            "compilerArgs": [
                "-Wall",
                "-Wextra"
            ]
        }
    ],
    "version": 4
}
