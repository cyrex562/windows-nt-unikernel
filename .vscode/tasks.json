{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Target Zero",
            "type": "shell",
            "command": "make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/target-zero"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build All Fixtures",
            "type": "shell",
            "command": "just",
            "args": ["build-fixtures"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Rust Workspace",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--workspace"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Everything",
            "type": "shell",
            "command": "just",
            "args": ["build-all"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                "$rustc"
            ],
            "group": "build"
        },
        {
            "label": "Run PE Loader",
            "type": "shell",
            "command": "just",
            "args": ["run-loader"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Clean All",
            "type": "shell",
            "command": "just",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
